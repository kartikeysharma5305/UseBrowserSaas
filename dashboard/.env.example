DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Artifact storage remains private. Use local for development or s3 for
# Amazon S3, Cloudflare R2, MinIO, and compatible services.
ARTIFACT_STORAGE_DRIVER="local"
ARTIFACT_STORAGE_ROOT="./browseruse_agent_data/artifacts"
ARTIFACT_MAX_BYTES_PER_RUN="26214400"
# Required only for the s3 driver. S3_ENDPOINT may be omitted for AWS S3.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="private-browser-artifacts"
S3_ACCESS_KEY_ID="<server-only-access-key>"
S3_SECRET_ACCESS_KEY="<server-only-secret-key>"
S3_FORCE_PATH_STYLE="true"
# Apply-mode migrations require an explicit environment match.
ARTIFACT_MIGRATION_ENVIRONMENT="local-development"
# Durable browser execution queue. Keep Redis credentials server-only.
REDIS_URL="redis://localhost:6379"
EXECUTION_QUEUE_NAME="browser-agent-runs"
EXECUTION_QUEUE_CONCURRENCY="1"
EXECUTION_QUEUE_ATTEMPTS="3"
EXECUTION_QUEUE_BACKOFF_MS="2000"
EXECUTION_QUEUE_HEARTBEAT_MS="5000"
EXECUTION_QUEUE_LEASE_MS="20000"
EXECUTION_QUEUE_SHUTDOWN_GRACE_MS="30000"
EXECUTION_QUEUE_MAX_WAITING="100"
# Live updates use Redis only for low-latency invalidation. PostgreSQL remains
# authoritative and the fallback poll recovers missed notifications.
SSE_HEARTBEAT_MS="15000"
SSE_FALLBACK_POLL_MS="2000"
SSE_MAX_CONNECTIONS_PER_USER="5"
SSE_MAX_CONNECTIONS_PER_RUN="3"
SSE_MAX_CONNECTION_DURATION_MS="1800000"
CANCELLATION_CHECK_INTERVAL_MS="1000"
# Product quotas are defined by the server-side FREE/PRO/INTERNAL catalogue.
BETTER_AUTH_SECRET="<generate-a-random-secret-at-least-32-characters>"
API_KEY_PEPPER="<generate-a-separate-random-secret-at-least-32-characters>"
WEBHOOK_SECRET_ENCRYPTION_KEY="<base64-encoded-random-32-byte-key>"
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3001"
GROQ_API_KEY="<server-only-groq-api-key>"
NVIDIA_API_KEY="<optional-server-only-nvidia-api-key>"
NVIDIA_NIM_ALLOWED_MODELS="<comma-separated-compatibility-proven-model-ids>"
BROWSER_USE_API_KEY="<optional-browser-use-api-key>"

# Billing / Stripe (placeholders only; do NOT commit secrets)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3001/dashboard/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3001/dashboard/billing?checkout=canceled
STRIPE_PORTAL_RETURN_URL=http://localhost:3001/dashboard/billing

# Durable operational email. Disabled startup requires no provider credentials.
EMAIL_ENABLED=false
EMAIL_PROVIDER=development
EMAIL_FROM="Browser Use <notifications@example.invalid>"
EMAIL_API_KEY=
APP_BASE_URL=http://localhost:3001
NOTIFICATION_QUEUE_NAME=notification-deliveries
NOTIFICATION_QUEUE_CONCURRENCY=3
NOTIFICATION_QUEUE_ATTEMPTS=5
NOTIFICATION_QUEUE_BACKOFF_MS=5000
NOTIFICATION_DELIVERY_LEASE_MS=60000

# Customer outbound webhooks. Loopback endpoints are development-only and
# remain disabled unless explicitly enabled for a controlled local receiver.
WEBHOOK_QUEUE_NAME=outbound-webhook-deliveries
WEBHOOK_QUEUE_CONCURRENCY=4
WEBHOOK_DELIVERY_ATTEMPTS=6
WEBHOOK_DELIVERY_BACKOFF_MS=2000
WEBHOOK_DELIVERY_LEASE_MS=30000
WEBHOOK_REQUEST_TIMEOUT_MS=10000
WEBHOOK_RESPONSE_BODY_LIMIT_BYTES=65536
WEBHOOK_DISABLE_THRESHOLD=6
WEBHOOK_ALLOW_LOOPBACK_ENDPOINTS=false
# Phase 20 admission kill switch. Set false during an execution incident; queued
# and running work is retained and workers continue their established policy.
EXECUTION_ENABLED=true
BROWSER_WORKER_CONCURRENCY=1
WORKER_DRAIN_TIMEOUT_MS=30000
WORKER_HEALTH_HEARTBEAT_MS=15000
BROWSER_SHUTDOWN_TIMEOUT_MS=5000
WORKER_BUILD_VERSION=local

# Internal operator endpoints accept this bearer token or an INTERNAL session.
# Use at least 32 random characters in non-local environments.
OBSERVABILITY_TOKEN=

# Public legal/contact identity. Required business decisions before public launch.
LEGAL_ENTITY_NAME=
PRIVACY_CONTACT_EMAIL=
SECURITY_CONTACT_EMAIL=
# Trust X-Forwarded-For/X-Real-IP only when a controlled reverse proxy overwrites them.
SECURITY_TRUST_PROXY_HEADERS=false

# Closed beta. Invite-only registration is enforced when enabled.
BETA_MODE=false
BETA_MAX_ACTIVE_USERS=25
BETA_INVITE_LIFETIME_DAYS=7
SUPPORT_CONTACT_EMAIL=
APP_RELEASE_ID=development
