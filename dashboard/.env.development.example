# Local development only. Copy to .env.local and replace every placeholder.
NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_INSTANCE_ID=local-dev
DATABASE_URL=postgresql://browser_use:browser_use_dev@localhost:5432/browser_use_dashboard
REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001
BETTER_AUTH_SECRET=<random-at-least-32-characters>
# Continuity-sensitive: changing this invalidates every existing public API key.
API_KEY_PEPPER=<separate-random-at-least-32-characters>
# Continuity-sensitive: base64 of exactly 32 random bytes. Rotation requires a migration.
WEBHOOK_SECRET_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
EXECUTION_ENABLED=true
GROQ_API_KEY=<server-only-key>
NVIDIA_API_KEY=<optional-server-only-key>
NVIDIA_NIM_ALLOWED_MODELS=<comma-separated-compatibility-proven-model-ids>
REDIS_ENVIRONMENT_NOTE=local-only
ARTIFACT_STORAGE_DRIVER=local
ARTIFACT_STORAGE_ROOT=./browseruse_agent_data/artifacts
BILLING_ENABLED=false
EMAIL_ENABLED=false
EMAIL_PROVIDER=development
WEBHOOK_ALLOW_LOOPBACK_ENDPOINTS=false
OBSERVABILITY_TOKEN=<random-at-least-32-characters>
LEGAL_ENTITY_NAME=
PRIVACY_CONTACT_EMAIL=
SECURITY_CONTACT_EMAIL=
BETA_MODE=false
BETA_MAX_ACTIVE_USERS=25
BETA_INVITE_LIFETIME_DAYS=7
SUPPORT_CONTACT_EMAIL=support@example.invalid
APP_RELEASE_ID=local-development
