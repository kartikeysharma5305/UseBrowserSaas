# Production-like staging. Never reuse production data, Redis, buckets, Stripe
# resources, email routing, or cryptographic secrets.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
DEPLOYMENT_INSTANCE_ID=browser-use-staging
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_DB_HOST:5432/STAGING_DB?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@STAGING_REDIS_HOST:6379
APP_BASE_URL=https://staging.example.invalid
NEXT_PUBLIC_APP_URL=https://staging.example.invalid
BETTER_AUTH_URL=https://staging.example.invalid
BETTER_AUTH_TRUSTED_ORIGINS=https://staging.example.invalid
BETTER_AUTH_SECRET=<staging-only-random-at-least-32-characters>
API_KEY_PEPPER=<stable-staging-only-random-at-least-32-characters>
WEBHOOK_SECRET_ENCRYPTION_KEY=<stable-staging-only-base64-32-byte-key>
OBSERVABILITY_TOKEN=<staging-only-random-at-least-32-characters>
EXECUTION_ENABLED=true
GROQ_API_KEY=<staging-server-only-key>
NVIDIA_API_KEY=<optional-staging-server-only-key>
NVIDIA_NIM_ALLOWED_MODELS=<comma-separated-compatibility-proven-model-ids>
ARTIFACT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://staging-object-provider.example.invalid
S3_REGION=<staging-region>
S3_BUCKET=<private-staging-only-bucket>
S3_ACCESS_KEY_ID=<staging-only-access-key>
S3_SECRET_ACCESS_KEY=<staging-only-secret-key>
S3_FORCE_PATH_STYLE=false
BILLING_ENABLED=true
STRIPE_SECRET_KEY=<stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=<staging-test-webhook-secret>
STRIPE_PRO_MONTHLY_PRICE_ID=<staging-test-price-id>
STRIPE_CHECKOUT_SUCCESS_URL=https://staging.example.invalid/dashboard/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://staging.example.invalid/dashboard/billing?checkout=canceled
STRIPE_PORTAL_RETURN_URL=https://staging.example.invalid/dashboard/billing
EMAIL_ENABLED=false
EMAIL_PROVIDER=development
STAGING_EMAIL_MODE=sandbox
EMAIL_FROM=Browser Use Staging <notifications@example.invalid>
EMAIL_API_KEY=
WEBHOOK_ALLOW_LOOPBACK_ENDPOINTS=false
SECURITY_TRUST_PROXY_HEADERS=true
WORKER_BUILD_VERSION=<release-id>
BROWSER_WORKER_CONCURRENCY=1
WORKER_DRAIN_TIMEOUT_MS=30000
WORKER_HEALTH_HEARTBEAT_MS=15000
BROWSER_SHUTDOWN_TIMEOUT_MS=5000
BETA_MODE=true
BETA_MAX_ACTIVE_USERS=25
BETA_INVITE_LIFETIME_DAYS=7
SUPPORT_CONTACT_EMAIL=<closed-beta-support-email>
APP_RELEASE_ID=<release-id>
