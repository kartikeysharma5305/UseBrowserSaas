# Production contract. Supply values from a secret manager; never commit a
# populated copy or share any value with staging.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_INSTANCE_ID=browser-use-production
DATABASE_URL=postgresql://RUNTIME_USER:PASSWORD@PRODUCTION_DB_HOST:5432/PRODUCTION_DB?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@PRODUCTION_REDIS_HOST:6379
APP_BASE_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
BETTER_AUTH_URL=https://app.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com
BETTER_AUTH_SECRET=<stable-random-at-least-32-characters>
# Do not rotate casually: existing public API keys depend on this pepper.
API_KEY_PEPPER=<stable-separate-random-at-least-32-characters>
# Do not rotate casually: existing outbound webhook secrets require this key.
WEBHOOK_SECRET_ENCRYPTION_KEY=<stable-base64-encoded-32-random-byte-key>
OBSERVABILITY_TOKEN=<random-at-least-32-characters>
EXECUTION_ENABLED=true
GROQ_API_KEY=<production-server-only-key>
NVIDIA_API_KEY=<optional-production-server-only-key>
NVIDIA_NIM_ALLOWED_MODELS=<comma-separated-compatibility-proven-model-ids>
ARTIFACT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://object-provider.example.com
S3_REGION=<production-region>
S3_BUCKET=<private-production-only-bucket>
S3_ACCESS_KEY_ID=<production-only-access-key>
S3_SECRET_ACCESS_KEY=<production-only-secret-key>
S3_FORCE_PATH_STYLE=false
BILLING_ENABLED=true
STRIPE_SECRET_KEY=<stripe-live-secret-key>
STRIPE_WEBHOOK_SECRET=<production-live-webhook-secret>
STRIPE_PRO_MONTHLY_PRICE_ID=<production-live-price-id>
STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/dashboard/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/dashboard/billing?checkout=canceled
STRIPE_PORTAL_RETURN_URL=https://app.example.com/dashboard/billing
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_FROM=Browser Use <notifications@example.com>
EMAIL_API_KEY=<production-email-provider-key>
WEBHOOK_ALLOW_LOOPBACK_ENDPOINTS=false
SECURITY_TRUST_PROXY_HEADERS=true
LEGAL_ENTITY_NAME=<reviewed-legal-entity>
PRIVACY_CONTACT_EMAIL=<active-privacy-contact>
SECURITY_CONTACT_EMAIL=<active-security-contact>
WORKER_BUILD_VERSION=<release-id>
BROWSER_WORKER_CONCURRENCY=1
WORKER_DRAIN_TIMEOUT_MS=30000
WORKER_HEALTH_HEARTBEAT_MS=15000
BROWSER_SHUTDOWN_TIMEOUT_MS=5000
BETA_MODE=true
BETA_MAX_ACTIVE_USERS=25
BETA_INVITE_LIFETIME_DAYS=7
SUPPORT_CONTACT_EMAIL=<closed-beta-support-email>
APP_RELEASE_ID=<release-id>
