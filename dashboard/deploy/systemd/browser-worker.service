[Unit]
Description=Browser Automation SaaS browser worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
ConditionPathExists=/opt/browser-use/dist/agent/index.js

[Service]
Type=simple
User=browser-use
Group=browser-use
WorkingDirectory=/opt/browser-use/dashboard
Environment=NODE_ENV=production
EnvironmentFile=/etc/browser-use/dashboard.env
ExecStart=/usr/bin/pnpm start:worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
