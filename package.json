    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-dom-tree.mjs",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "vitest run",
    "test:billing": "vitest run test/billing-config.test.ts test/billing-backend.test.ts test/billing-entitlements.test.ts test/billing-routes.test.ts test/billing-webhook-route.test.ts",
    "test:billing-ui": "vitest run test/billing-ui.test.ts",
    "test:billing-reconciliation": "vitest run test/billing-reconciliation.test.ts",
    "test:account-deletion": "vitest run test/account-deletion.test.ts",
    "test:beta": "vitest run test/closed-beta.test.ts",
    "test:nvidia-provider": "vitest run test/nvidia-nim-provider.test.ts test/agent-reliability-benchmark.test.ts test/dashboard-browser-execution-errors.test.ts",
    "beta:reliability": "pnpm --dir dashboard beta:reliability",
    "provider:test:nvidia": "tsx --env-file=dashboard/.env --env-file=dashboard/.env.local scripts/test-nvidia-provider.ts",
    "provider:probe:nvidia": "pnpm provider:test:nvidia -- --all",
    "test:scheduling": "vitest run test/scheduling-*.test.ts",
    "test:notifications": "vitest run test/notifications-*.test.ts",
    "test:templates": "vitest run test/templates-*.test.ts test/onboarding-*.test.ts",
    "test:variables": "vitest run test/agent-variables*.test.ts",
    "test:execution-safety": "vitest run test/execution-safety-*.test.ts",
    "test:structured-results": "vitest run test/structured-results-*.test.ts",
    "test:public-api": "vitest run test/public-api-*.test.ts",
    "test:webhooks": "vitest run test/outbound-webhooks-*.test.ts",
    "test:security": "vitest run test/platform-security.test.ts",
    "test:cost-controls": "vitest run test/cost-controls.test.ts",
    "test:worker-scaling": "vitest run test/worker-scaling.test.ts",
    "test:observability": "vitest run test/observability.test.ts",
    "security:audit": "pnpm audit --audit-level high",
    "security:secrets": "node scripts/security-secret-scan.mjs",
    "security:migrations": "node scripts/security-migration-integrity.mjs",
    "test:governance": "vitest run test/data-governance.test.ts test/account-deletion.test.ts test/platform-security.test.ts test/public-api-security.test.ts test/dashboard-login-form.test.ts",
    "test:deployment": "vitest run test/deployment-readiness.test.ts",
    "test:dashboard": "vitest run test/dashboard-*.test.ts",
    "test:engine": "vitest run test --exclude test/dashboard-*.test.ts --exclude test/billing-*.test.ts",
    "test:unit": "vitest run test --exclude test/integration*.test.ts --exclude test/cli-interactive.e2e.test.ts --exclude test/codex-oauth-smoke.e2e.test.ts",
    "test:integration": "vitest run test/integration.test.ts test/integration-advanced.test.ts",
    "test:e2e": "vitest run test/cli-interactive.e2e.test.ts",
    "test:e2e:codex": "BROWSER_USE_CODEX_E2E=1 vitest run test/codex-oauth-smoke.e2e.test.ts",
    "test:e2e:codex:agent": "BROWSER_USE_CODEX_E2E=1 BROWSER_USE_CODEX_E2E_AGENT=1 vitest run test/codex-oauth-smoke.e2e.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:pack": "node scripts/smoke-pack.mjs",
    "test:startup": "pnpm build && node scripts/check-cli-startup.mjs",
    "skill:commands:sync": "tsx scripts/sync-direct-skill-commands.ts",
    "skill:commands:check": "tsx scripts/sync-direct-skill-commands.ts --check",
    "version:check": "node scripts/update-version.mjs --check",
    "version:sync": "node scripts/update-version.mjs sync",
    "version:bump": "node scripts/update-version.mjs",
    "version:patch": "node scripts/update-version.mjs patch",
    "version:minor": "node scripts/update-version.mjs minor",
    "version:major": "node scripts/update-version.mjs major",
    "check": "pnpm lint && pnpm skill:commands:check && pnpm typecheck && pnpm typecheck:test && pnpm test:startup && pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm test:pack",
    "commit": "cz",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepack": "pnpm skill:commands:check && pnpm build",
    "postinstall": "playwright install chromium",
    "postinstall:ci": "playwright install --with-deps chromium",
    "dashboard:dev": "pnpm --dir dashboard dev",
    "dashboard:build": "pnpm --dir dashboard build",
    "dashboard:start": "pnpm --dir dashboard start",
    "production:build": "pnpm dashboard:prisma:generate && pnpm build && pnpm dashboard:build",
    "production:preflight": "pnpm --dir dashboard production:preflight",
    "production:migrate": "pnpm --dir dashboard production:migrate",
    "production:smoke": "pnpm --dir dashboard production:smoke",
    "staging:test:runtime": "pnpm --dir dashboard staging:test:runtime",
    "start:dashboard": "pnpm --dir dashboard start:dashboard",
    "start:worker": "pnpm --dir dashboard start:worker",
    "start:scheduler": "pnpm --dir dashboard start:scheduler",
    "start:notifications": "pnpm --dir dashboard start:notifications",
    "start:webhooks": "pnpm --dir dashboard start:webhooks",
    "dashboard:lint": "pnpm --dir dashboard lint",
    "dashboard:typecheck": "pnpm --dir dashboard typecheck",
    "dashboard:prisma:generate": "pnpm --dir dashboard prisma:generate",
    "dashboard:prisma:migrate": "pnpm --dir dashboard prisma:migrate",
    "dashboard:prisma:validate": "pnpm --dir dashboard prisma:validate",
    "dashboard:prisma:status": "pnpm --dir dashboard prisma:status",
    "dashboard:prisma:deploy": "pnpm --dir dashboard prisma:deploy",
    "dashboard:worker": "pnpm --dir dashboard worker:browser",
    "dashboard:queue:health": "pnpm --dir dashboard queue:health",
    "backup:db": "pnpm --dir dashboard backup:db",
    "backup:verify": "pnpm --dir dashboard backup:verify",
    "backup:restore": "pnpm --dir dashboard backup:restore",
    "backup:artifacts": "pnpm --dir dashboard backup:artifacts",
    "backup:artifacts:verify": "pnpm --dir dashboard backup:artifacts:verify",
    "backup:retain": "pnpm --dir dashboard backup:retain",
    "test:backup": "vitest run test/disaster-recovery.test.ts",
    "reconcile:all": "pnpm --dir dashboard reconcile:all",
    "billing:reconcile": "pnpm -C dashboard billing:reconcile",
    "dashboard:queue:recover": "pnpm --dir dashboard queue:recover",
    "dashboard:queue:test": "pnpm --dir dashboard queue:test",
    "dashboard:worker:test": "pnpm --dir dashboard worker:test",
    "dashboard:phase4:test:runtime": "pnpm --dir dashboard phase4:test:runtime",
    "dashboard:phase4:test:reliability": "pnpm --dir dashboard phase4:test:reliability",
    "dashboard:phase4:test:worker-recovery": "pnpm --dir dashboard phase4:test:worker-recovery",
    "dashboard:phase4:test:redis": "pnpm --dir dashboard phase4:test:redis",
    "dashboard:phase4:test:shutdown": "pnpm --dir dashboard phase4:test:shutdown",
    "dev:preflight": "pnpm --dir dashboard exec tsx scripts/dev-preflight.ts",
    "dev:prepare": "pnpm dev:preflight && pnpm build && pnpm dashboard:prisma:generate && pnpm dashboard:prisma:validate && node scripts/dev-migration-status.mjs",
    "dev:engine": "pnpm build:watch",
    "dev:dashboard": "pnpm --dir dashboard dev",
    "dev:worker": "pnpm --dir dashboard worker:browser",
    "dev:scheduler": "pnpm --dir dashboard scheduler:start",
    "dev:notifications": "pnpm --dir dashboard worker:notifications",
    "dev:webhooks": "pnpm --dir dashboard worker:webhooks",
    "scheduler:start": "pnpm --dir dashboard scheduler:start",
    "notifications:reconcile": "pnpm --dir dashboard notifications:reconcile",
    "webhooks:reconcile": "pnpm --dir dashboard webhooks:reconcile",
    "phase7:test:runtime": "pnpm --dir dashboard phase7:test:runtime",
    "phase8:test:runtime": "pnpm --dir dashboard phase8:test:runtime",
    "phase9:test:runtime": "pnpm --dir dashboard phase9:test:runtime",
    "phase20:test:runtime": "pnpm --dir dashboard phase20:test:runtime",
    "phase20:test:browser": "pnpm --dir dashboard phase20:test:browser",
    "phase21:test:runtime": "pnpm --dir dashboard phase21:test:runtime",
    "phase22:test:runtime": "pnpm --dir dashboard phase22:test:runtime",
    "phase23:test:runtime": "pnpm --dir dashboard phase23:test:runtime",
    "phase24:test:runtime": "pnpm --dir dashboard phase24:test:runtime",
    "phase25:test:runtime": "pnpm --dir dashboard phase25:test:runtime",
    "dev:all": "pnpm dev:prepare && concurrently --kill-others --handle-input=false --names engine,dashboard,worker,scheduler,notifications,webhooks --prefix-colors blue,green,magenta,yellow,cyan,white \"pnpm dev:engine\" \"pnpm dev:dashboard\" \"pnpm dev:worker\" \"pnpm dev:scheduler\" \"pnpm dev:notifications\" \"pnpm dev:webhooks\"",
    "dev:infra": "docker compose -f compose.dev.yaml up -d --wait",
    "dev:infra:stop": "docker compose -f compose.dev.yaml down",
    "dev:infra:down": "pnpm dev:infra:stop",
    "dev:infra:reset": "docker compose -f compose.dev.yaml down --volumes",
    "dev:all:docker": "pnpm dev:infra && pnpm dev:all",
    "setup:local": "pnpm dev:preflight && pnpm dashboard:prisma:generate && pnpm dashboard:prisma:validate && pnpm dashboard:prisma:deploy && pnpm build && node -e \"console.log('Local setup complete. Next: pnpm dev:all')\""
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
